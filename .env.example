# Salin menjadi .env di folder back-end. Jangan commit .env.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Root URL BE yang dapat diakses perangkat (tanpa /api atau slash di akhir).
# Pada HP fisik, ganti localhost dengan IP LAN laptop yang menjalankan BE.
APP_URL=http://localhost:3000
# Origin Expo Web untuk CORS. Satu origin, tanpa slash di akhir.
FRONTEND_URL=http://localhost:8081

# Wajib untuk startup: PostgreSQL lokal/VPS atau provider PostgreSQL.
DATABASE_URL=postgresql://pickme:change-me@127.0.0.1:5432/pickme

# Isi dua secret acak BERBEDA, jangan gunakan default kode untuk deployment.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth: Web Client ID yang juga dipakai FE.
GOOGLE_CLIENT_ID=
# Tambahan audience OAuth yang diizinkan, dipisahkan koma (opsional).
GOOGLE_CLIENT_IDS=

# Penyimpanan: local untuk VPS; blob untuk Vercel Blob (default kode).
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
# Hanya wajib bila STORAGE_PROVIDER=blob.
BLOB_READ_WRITE_TOKEN=

# Opsional: analisis foto dengan Gemini; kosong = input metadata manual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROJECT_NUMBER=410479006895
# Dideklarasikan di config, belum digunakan oleh service saat ini.
GOOGLE_PLACES_API_KEY=

# Opsional: pemindai file eksternal. URL wajib jika enabled=true.
ANTIVIRUS_ENABLED=false
ANTIVIRUS_SCAN_URL=
ANTIVIRUS_TIMEOUT_MS=7000

# Default kode saat ini: 300 request / 60 detik.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
